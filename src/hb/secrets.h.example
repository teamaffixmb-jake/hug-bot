#ifndef HUG_BOT_SECRETS_H
#define HUG_BOT_SECRETS_H

// Copy this file to secrets.h and fill in the tokens.
// secrets.h is gitignored. Never commit a real token.
//
// 0 = this firmware is hug-a (talks to hug-b).
// 1 = this firmware is hug-b (talks to hug-a).
// Or pass -DHB_DEVICE_B=1 at compile time and leave this unset.

#ifndef HB_DEVICE_B
#define HB_DEVICE_B 0
#endif

namespace hb {
namespace mqtt {

constexpr char k_host[] = "d02535507ia2fhgpaooo-ats.iot.us-west-2.amazonaws.com";
constexpr char k_device_a_token[] = "paste-device-a-token-here";
constexpr char k_device_b_token[] = "paste-device-b-token-here";

}  // namespace mqtt
}  // namespace hb

#endif  // HUG_BOT_SECRETS_H
